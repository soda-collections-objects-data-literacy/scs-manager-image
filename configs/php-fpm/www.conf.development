[www]
user = www-data
group = www-data
listen = 127.0.0.1:9000

; Dynamic process manager.
pm = dynamic

; Maximum number of child processes (lower for development).
pm.max_children = 10

; Number of child processes created on startup.
pm.start_servers = 2

; Minimum number of spare idle processes.
pm.min_spare_servers = 1

; Maximum number of spare idle processes.
pm.max_spare_servers = 3

; Maximum number of requests each child process should execute.
pm.max_requests = 200

; Request timeout (longer for debugging).
request_terminate_timeout = 600

; Catch worker output (important for debugging).
catch_workers_output = yes

; Clear environment.
clear_env = no
